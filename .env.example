# ============ 大模型配置 ============
# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-830ccf1d16eb4b4aafe05214f0fa1be6
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ Embedding 配置 ============
# 本地 Embedding 模型（HuggingFace）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若使用在线 Embedding API，可改为：openai / dashscope
EMBEDDING_PROVIDER=local

# ============ 向量库配置 ============
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=data/vector_store
CHROMA_COLLECTION_ZHKU=zhku_campus
CHROMA_COLLECTION_DOCUMENT=zhku_documents

# ============ 数据库配置 ============
SQLITE_PATH=data/sqlite/zhku.db

# ============ 第三方 API 配置 ============
# 和风天气 API Key（免费订阅：https://dev.qweather.com/）
QWEATHER_API_KEY=

# ============ 数据采集配置 ============
ZHKU_BASE_URL=https://www.zhku.edu.cn/
ZHKU_JWC_URL=https://jwc.zhku.edu.cn/
ZHKU_YJS_URL=https://yjs.zhku.edu.cn/
ZHKU_JOB_URL=https://job.zhku.edu.cn/
ZHKU_HQYZC_URL=https://hqyzc.zhku.edu.cn/
ZHKU_WLZX_URL=https://wlzx.zhku.edu.cn/
ZHKU_XYS_URL=https://xys.zhku.edu.cn/

# 采集请求间隔（秒）
CRAWL_DELAY=1.0
# 采集超时（秒）
CRAWL_TIMEOUT=15
# User-Agent
CRAWL_USER_AGENT=ZHKU-Campus-Agent/0.1 (+https://www.zhku.edu.cn/)

# ============ RAG 配置 ============
# 文本切分
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 检索 Top-K
RAG_TOP_K=5
# 检索相似度阈值
RAG_SCORE_THRESHOLD=0.5

# ============ Agent 配置 ============
# 路由方式：rule | llm
AGENT_ROUTER_MODE=rule
# 是否启用兜底
ENABLE_FALLBACK=true

# ============ 服务配置 ============
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO
